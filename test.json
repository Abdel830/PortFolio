      "name": "1. Lire toutes les entreprises",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [320, 300]
    },
    {
      "parameters": {
        "jsCode": "// Récupérer toutes les lignes du Google Sheet\nconst items = $input.all();\nconst lignesPropres = [];\nlet lignesSupprimees = 0;\n\n// Fonction pour vérifier si une cellule est vide ou contient \"Non trouvé\"\nfunction estInvalide(valeur) {\n  if (!valeur) return true; // null, undefined, ou chaîne vide \"\"\n  const texte = String(valeur).trim().toLowerCase();\n  return texte === '' || \n         texte === 'non trouvé' || \n         texte === 'non trouvée' || \n         texte === 'n/a' || \n         texte === '-';\n}\n\nfor (const item of items) {\n  const ligne = item.json;\n  const email = ligne['Email'];\n  const linkedin = ligne['LinkedIn'];\n\n  const aEmailValide = !estInvalide(email);\n  const aLinkedInValide = !estInvalide(linkedin);\n\n  // Condition : On garde SI ET SEULEMENT SI il y a un Email OU un LinkedIn\n  if (aEmailValide || aLinkedInValide) {\n    // Bonus Propreté : On remplace \"Non trouvé\" par une vraie cellule vide\n    if (!aEmailValide) ligne['Email'] = '';\n    if (!aLinkedInValide) ligne['LinkedIn'] = '';\n    \n    // On supprime les métadonnées internes de lecture n8n avant réécriture\n    delete ligne['row_number'];\n    delete ligne['rowNumber'];\n    \n    lignesPropres.push({ json: ligne });\n  } else {\n    lignesSupprimees++;\n  }\n}\n\nconsole.log(`Nettoyage terminé : ${lignesPropres.length} conservées, ${lignesSupprimees} supprimées.`);\nreturn lignesPropres;"
      },
